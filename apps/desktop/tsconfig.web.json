{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src/renderer",
    "outDir": ".tsbuild/web",
    "tsBuildInfoFile": ".tsbuild/web/.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"],
  "references": [{ "path": "../../packages/contracts" }]
}
