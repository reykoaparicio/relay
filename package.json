{
  "name": "relay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @relay/desktop dev",
    "dev:renderer": "pnpm --filter @relay/desktop dev:renderer",
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter @relay/desktop build",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint . --max-warnings 0 && depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit --project unit-web",
    "test:integration": "vitest run --project integration",
    "test:live": "vitest run --project live",
    "test": "pnpm test:unit && pnpm test:integration",
    "e2e": "pnpm build && PLAYWRIGHT_HTML_OPEN=never playwright test",
    "test:e2e": "pnpm e2e",
    "gen:api-doc": "pnpm --silent --filter @relay/contracts gen:api-doc > docs/architecture/ipc-api.md",
    "evaluate": "tsx scripts/evaluate.ts",
    "package": "pnpm build && pnpm --filter @relay/desktop package",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:verify": "tsx scripts/demo-verify.ts",
    "check:secrets": "tsx scripts/check-no-secrets.ts",
    "check:project-untouched": "tsx scripts/check-project-untouched.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@relay/contracts": "workspace:*",
    "@relay/engine": "workspace:*",
    "@relay/providers": "workspace:*",
    "@relay/storage": "workspace:*",
    "@relay/templates": "workspace:*",
    "@relay/tools": "workspace:*",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
