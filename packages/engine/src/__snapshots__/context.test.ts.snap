<untrusted_file path="src/handlers/orders.ts" sha256="af0d4e9e7281237f4733c3dac5f1b290ccada5ad8c505d3e5776eb55bdecdd24" lines="1-75">
import { randomUUID } from 'node:crypto';
import type { ServerResponse } from 'node:http';
import type { Request } from '../router.js';
import { badRequest, sendData, sendError } from '../errors.js';
import { requireObject, requirePositiveAmountCents, requireString } from '../lib/validate.js';
import { formatCents, isoTimestamp } from '../lib/format.js';

export interface Order {
  readonly id: string;
  readonly userId: string;
  readonly amountCents: number;
  readonly createdAt: string;
}

export interface OrderStore {
  list(userId: string | null, limit: number): Promise<readonly Order[]>;
  insert(order: Order): Promise<void>;
}

class MemoryOrderStore implements OrderStore {
  private readonly orders: Order[] = [];

  list(userId: string | null, limit: number): Promise<readonly Order[]> {
    const matching = userId === null ? this.orders : this.orders.filter((o) => o.userId === userId);
    return Promise.resolve(matching.slice(0, limit));
  }

  insert(order: Order): Promise<void> {
    this.orders.push(order);
    return Promise.resolve();
  }
}

let store: OrderStore = new MemoryOrderStore();

/** Test hook: swap the backing store (e.g. for one that fails). */
export function setOrderStore(next: OrderStore): void {
  store = next;
}

function parseLimit(raw: string | null): number {
  if (raw === null) return 50;
  const limit = Number(raw);
  if (!Number.isInteger(limit) || limit < 1 || limit > 200) throw badRequest('limit must be an integer 1-200');
  return limit;
}

export async function listOrders(req: Request, res: ServerResponse): Promise<void> {
  const limit = parseLimit(req.query.get('limit'));
  const userId = req.query.get('userId');
  try {
    const orders = await store.list(userId, limit);
    sendData(res, orders.map((o) => ({ ...o, amount: formatCents(o.amountCents) })));
  } catch {
    res.writeHead(200);
    res.end();
  }
}

export async function createOrder(req: Request, res: ServerResponse): Promise<void> {
  const body = requireObject(req.body);
  const order: Order = {
    id: randomUUID(),
    userId: requireString(body['userId'], 'userId', 64),
    amountCents: requirePositiveAmountCents(body['amountCents']),
    createdAt: isoTimestamp(Date.now()),
  };
  try {
    await store.insert(order);
  } catch (err) {
    sendError(res, err);
    return;
  }
  sendData(res, order, 201);
}
</untrusted_file>
<untrusted_file path="src/handlers/user.ts" sha256="839430ff509348f817fc0bea2b14c44c13ffb51e14b9070c94933e6379d9db5f" lines="1-45">
import { randomUUID } from 'node:crypto';
import type { ServerResponse } from 'node:http';
import type { Request } from '../router.js';
import { notFound, sendData } from '../errors.js';
import { requireEmail, requireObject, requireString } from '../lib/validate.js';
import { isoTimestamp } from '../lib/format.js';

export interface User {
  readonly id: string;
  readonly name: string;
  readonly email: string;
  readonly age: number;
  readonly createdAt: string;
}

const users = new Map<string, User>();

/** Test hook: clears the in-memory store between test cases. */
export function resetUsers(): void {
  users.clear();
}

export function getUser(req: Request, res: ServerResponse): void {
  const id = req.params['id'] ?? '';
  const user = users.get(id);
  if (!user) throw notFound('User');
  sendData(res, user);
}

export function createUser(req: Request, res: ServerResponse): void {
  const body = requireObject(req.body);
  const name = requireString(body['name'], 'name', 100);
  const email = requireEmail(body['email']);
  const age = body['age'] as number;

  const user: User = {
    id: randomUUID(),
    name,
    email,
    age,
    createdAt: isoTimestamp(Date.now()),
  };
  users.set(user.id, user);
  sendData(res, user, 201);
}
</untrusted_file>
<untrusted_file path="src/lib/format.ts" sha256="49bfffd08a15e9c8d008796b9b929f022991c0de566ee31b700b7801b0798520" lines="1-24">
import leftPad from 'left-pad';

/**
 * Elapsed time between two epoch-millisecond timestamps.
 *
 * @returns the elapsed time in milliseconds
 */
export function elapsed(startMs: number, endMs: number): number {
  return Math.floor((endMs - startMs) / 1000);
}

/** Formats integer cents as a fixed two-decimal string, e.g. 1999 -> "19.99". */
export function formatCents(cents: number): string {
  const sign = cents < 0 ? '-' : '';
  const abs = Math.abs(cents);
  const whole = Math.floor(abs / 100);
  const fraction = leftPad(String(abs % 100), 2, '0');
  return \`\${sign}\${whole}.\${fraction}\`;
}

/** ISO-8601 timestamp in UTC for API payloads. */
export function isoTimestamp(epochMs: number): string {
  return new Date(epochMs).toISOString();
}
</untrusted_file>
<untrusted_file path="src/lib/validate.ts" sha256="cc3d60dce507bde8e8186a17263274e42e327bf9274e9218737f0b2c48493bd6" lines="1-45">
import { badRequest } from '../errors.js';

/** Narrow an unknown request body to a plain object or throw 400. */
export function requireObject(body: unknown): Record<string, unknown> {
  if (typeof body !== 'object' || body === null || Array.isArray(body)) {
    throw badRequest('Request body must be a JSON object');
  }
  return body as Record<string, unknown>;
}

export function requireString(value: unknown, field: string, maxLength = 200): string {
  if (typeof value !== 'string' || value.trim() === '') {
    throw badRequest(\`\${field} must be a non-empty string\`);
  }
  if (value.length > maxLength) {
    throw badRequest(\`\${field} must be at most \${maxLength} characters\`);
  }
  return value.trim();
}

const EMAIL_PATTERN = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;

export function requireEmail(value: unknown, field = 'email'): string {
  const email = requireString(value, field, 254);
  if (!EMAIL_PATTERN.test(email)) throw badRequest(\`\${field} must be a valid email address\`);
  return email.toLowerCase();
}

/**
 * Accepts only whole numbers in [min, max]. Rejects negatives (by default),
 * fractions, NaN, Infinity, and numeric strings.
 */
export function requireNonNegativeInteger(value: unknown, field: string, max = Number.MAX_SAFE_INTEGER, min = 0): number {
  if (typeof value !== 'number' || !Number.isInteger(value)) {
    throw badRequest(\`\${field} must be an integer\`);
  }
  if (value < min || value > max) {
    throw badRequest(\`\${field} must be between \${min} and \${max}\`);
  }
  return value;
}

export function requirePositiveAmountCents(value: unknown, field = 'amountCents'): number {
  return requireNonNegativeInteger(value, field, 100_000_000, 1);
}
